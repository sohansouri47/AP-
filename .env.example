# =====================================================================
# ZAMP AP AI Employee — Environment Configuration Template
# Copy this file to .env and insert your API keys:
#   cp .env.example .env
# =====================================================================

# 1. OpenAI API Credentials (Required for multimodal vision & reasoning)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_KEY=sk-proj-your-openai-api-key-here

# 2. Langfuse Observability & LLM Cost Tracking (Optional but recommended)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# 3. PostgreSQL Database Credentials (Used by Docker Compose)
POSTGRES_DB=zamp_ap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
